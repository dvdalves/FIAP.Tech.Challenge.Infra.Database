aws_region                  = "us-east-1"
environment                 = "production"
db_identifier               = "oficina-postgres-db"
db_name                     = "oficina_db"
db_username                 = "oficina_admin"
db_password                 = "" # Deixar vazio para gerar automaticamente no AWS Secrets Manager
db_instance_class           = "db.t4g.micro"
allocated_storage           = 20
max_allocated_storage       = 50
engine_version              = "16.3"
vpc_id                      = "" # Preencher com o ID da VPC do repositório Kubernetes ou deixar vazio para default
private_subnet_ids          = [] # Preencher com as subnets privadas do EKS
vpc_cidr                    = "10.0.0.0/16"
backup_retention_period     = 7
multi_az                    = false
deletion_protection         = false
skip_final_snapshot         = true
enable_performance_insights = true
